# Copy this file to .env and fill in real values. Never commit .env.

# --- Django core ---
SECRET_KEY=
DEBUG=
ALLOWED_HOSTS=
IP_CSRF_ENV=

# --- Main database (HiveForest) ---
DB_HIVEFOREST_ENGINE=
DB_HIVEFOREST_DATABASE=
DB_HIVEFOREST_USER=
DB_HIVEFOREST_PASSWORD=
DB_HIVEFOREST_HOST=
DB_HIVEFOREST_PORT=
DB_HIVEFOREST_OPTIONS=
DB_HIVEFOREST_OPTIONS_VALUE=

# --- Logging ---
LOGGING_FILENAME_DJANGO=

# --- Session / CSRF ---
SESSION_COOKIE_AGE=
SESSION_COOKIE_HTTPONLY=
CSRF_COOKIE_HTTPONLY=
SESSION_SAVE_EVERY_REQUEST=
SESSION_EXPIRE_AT_BROWSER_CLOSE=
CSRF_COOKIE_SAMESITE=
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=

# --- Internal service-to-service API key (must match hiveforest-api's INTERNAL_API_KEY) ---
INTERNAL_API_KEY=

# --- Email / password reset ---
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_TLS=
EMAIL_USE_SSL=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
PASSWORD_RESET_TIMEOUT=

# --- Password policy ---
FORCE_PASSWORD_EXPIRY_DAYS=
STANDARD_PASSWORDS=
ALLOWED_DOMAIN=

# --- HTTPS / HSTS ---
SECURE_SSL_REDIRECT=
SECURE_HSTS_SECONDS=
SECURE_HSTS_INCLUDE_SUBDOMAINS=
SECURE_HSTS_PRELOAD=

# --- WhiteNoise ---
WHITENOISE_USE_FINDERS=

# --- Entra ID / OIDC (optional, requires mozilla_django_oidc) ---
CLIENT_ID=
CLIENT_SECRET=
TENANT_ID=
OIDC_ENDPOINT=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_USER_ENDPOINT=
OIDC_JWKS_ENDPOINT=
OIDC_RP_SIGN_ALGO=
OIDC_RP_SCOPES=
OIDC_USE_NONCE=
OIDC_STORE_ID_TOKEN=
OIDC_VERIFY_JWT=
OIDC_STATE_SIZE=
OIDC_NONCE_SIZE=

# --- Finance data source: AR (Accounts Receivable) ---
# Shared credentials, but ARBalance and ARCollection connect to different hosts
DB_AR_USER=
DB_AR_PASSWORD=
DB_AR_DATABASE=
DB_AR_BALANCE_HOST=
DB_AR_BALANCE_PORT=
DB_AR_COLLECTION_HOST=
DB_AR_COLLECTION_PORT=

# --- Supply chain data source: MUP ---
DB_MUP_HOST=
DB_MUP_PORT=
DB_MUP_USER=
DB_MUP_PASSWORD=
DB_MUP_DATABASE=

# --- Supply chain data source: STFTP ---
DB_STFTP_HOST=
DB_STFTP_PORT=
DB_STFTP_USER=
DB_STFTP_PASSWORD=
DB_STFTP_DATABASE=
DB_STFTP_TABLE=

# --- Sales data source: APL ---
DB_APL_HOST=
DB_APL_PORT=
DB_APL_USER=
DB_APL_PASSWORD=
DB_APL_DATABASE=
DB_APL_QUERY=

# --- Sales reconciliation / raw import tuning ---
RAWMUSO_DAYS_BACK=
